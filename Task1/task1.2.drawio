        <mxCell id="r9bccQTJQKtCH9OfjPY4-60" connectable="0" parent="r9bccQTJQKtCH9OfjPY4-59" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="Загрузка данных о клиентах" vertex="1">
          <mxGeometry relative="1" x="-0.5461" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r9bccQTJQKtCH9OfjPY4-66" edge="1" parent="1" source="r9bccQTJQKtCH9OfjPY4-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.98;entryY=0.333;entryDx=0;entryDy=0;entryPerimeter=0;" target="r9bccQTJQKtCH9OfjPY4-31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r9bccQTJQKtCH9OfjPY4-68" connectable="0" parent="r9bccQTJQKtCH9OfjPY4-66" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="Поддержка системы" vertex="1">
          <mxGeometry relative="1" x="-0.4442" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r9bccQTJQKtCH9OfjPY4-69" parent="1" style="fillColor=none;html=1;fontSize=12;fontStyle=0;align=left;fontStyle=1;fontSize=11" value="&lt;font style=&quot;font-size: 21px;&quot;&gt;Описание кредитного процесса&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="380" x="1199" y="-314" as="geometry" />
        </mxCell>
        <mxCell id="r9bccQTJQKtCH9OfjPY4-70" parent="1" style="rounded=1;arcSize=9;fillColor=#F7F8F9;align=center;spacingLeft=5;strokeColor=#DEE1E6;html=1;strokeWidth=2;fontColor=#596780;fontSize=12;whiteSpace=wrap;convertToSvg=0;" value="&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Кредитный процесс включает несколько этапов,&lt;/font&gt;&amp;nbsp;&lt;font face=&quot;Calibri&quot;&gt;в которых участвуют клиент, сотрудник фронт-офиса,&lt;/font&gt;&amp;nbsp;&lt;font face=&quot;Calibri&quot;&gt;сотрудник бэк-офиса (кредиты) и автоматизированные&lt;/font&gt;&amp;nbsp;&lt;font face=&quot;Calibri&quot;&gt;системы (АБС, Кредитный конвейер, Скоринг, Б&lt;/font&gt;&lt;font face=&quot;Calibri&quot;&gt;юро кредитных историй (БКИ)&lt;/font&gt;).&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&amp;nbsp;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;1 &lt;font face=&quot;Calibri&quot;&gt;Подача заявки (только в отделении)&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Клиент приходит в отделение.&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Сотрудник вносит данные заявки в АБС.&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Клиенту сообщают, что решение будет позже.&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;br&gt;2 &lt;font face=&quot;Calibri&quot;&gt;Передача в Кредитный конвейер&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Раз в сутки АБС выгружает новые заявки в Кредитный конвейер.&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Заявки распределяются между сотрудниками бэк-офиса.&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;br&gt;3 &lt;font face=&quot;Calibri&quot;&gt;Рассмотрение и скоринг&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Сотрудник бэк-офиса открывает заявку в конвейере.&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Конвейер вызывает Скоринг (REST API), тот запрашивает данные из БКИ&lt;/font&gt;&amp;nbsp;&lt;font face=&quot;Calibri&quot;&gt;и использует данные из АБС (загружаются раз в сутки).&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Скоринг возвращает рейтинг, сотрудник принимает решение (одобрить/отклонить).&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;br&gt;4 &lt;font face=&quot;Calibri&quot;&gt;Передача решения в АБС&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Раз в сутки одобренные заявки передаются из конвейера в АБС.&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;АБС проводит зачисление средств на счёт клиента.&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&amp;nbsp;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;5 &lt;font face=&quot;Calibri&quot;&gt;Уведомление клиента&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Возможно СМС-уведомление (через СМС-шлюз) о решении.&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0pt 0pt 0.0001pt; font-family: Calibri; color: rgb(0, 0, 0); font-size: medium; text-wrap-mode: wrap;&quot;&gt;&lt;font face=&quot;Calibri&quot;&gt;Клиент может прийти в отделение для подписания документов&lt;/font&gt;.&lt;/p&gt;" vertex="1">
          <mxGeometry height="460" width="1030" x="1169" y="-250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
